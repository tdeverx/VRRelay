    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@vrrelay/adapters": "*",
    "@vrrelay/application": "*",
    "@vrrelay/contracts": "*",
    "@vrrelay/domain": "*",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.1"
  }
