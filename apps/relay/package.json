    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@vrrelay/adapters": "*",
    "@vrrelay/application": "*",
    "@vrrelay/contracts": "*",
    "@vrrelay/domain": "*",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
