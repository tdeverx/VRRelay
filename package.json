{
  "name": "vrrelay",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hosted Jellyfin VOD and OBS live relay for VRChat video players.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeverx/VRRelay.git"
  },
  "homepage": "https://github.com/tdeverx/VRRelay#readme",
  "bugs": {
    "url": "https://github.com/tdeverx/VRRelay/issues"
  },
  "keywords": [
    "self-hosted",
    "vrchat",
    "jellyfin",
    "ffmpeg",
    "mediamtx",
    "sveltekit"
  ],
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/relay",
    "apps/web",
    "apps/windows",
    "packages/*"
  ],
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  },
  "scripts": {
    "benchmark": "node script/benchmark.mjs",
    "build": "npm run build:packages && npm run build --workspace @vrrelay/relay && npm run build --workspace @vrrelay/web && node script/sync-web.mjs",
    "build:packages": "npm run build --workspace @vrrelay/domain && npm run build --workspace @vrrelay/contracts && npm run build --workspace @vrrelay/application && npm run build --workspace @vrrelay/adapters",
    "clean": "node script/clean.mjs",
    "check": "npm run check:api && npm run check:agent-protocol-schema && npm run check --workspaces --if-present && npm run check:tests && npm run check:repo && npm run check:kubernetes && npm run check:cloud-init && npm run check:backup && npm run check:tls && npm run check:native-packaging",
    "check:agent-protocol-schema": "node --import tsx script/generate-agent-protocol-schema.mjs --check",
    "check:api": "node script/generate-api.mjs --check",
    "check:backup": "node script/check-backup-restore.mjs",
    "check:compose": "script/check-compose.sh",
    "check:cloud-init": "node script/check-cloud-init.mjs",
    "check:kubernetes": "node script/check-kubernetes-templates.mjs",
    "check:native-packaging": "node script/check-native-packaging.mjs",
    "check:repo": "node script/check-repository.mjs",
    "check:tests": "tsc -p tsconfig.tests.json",
    "check:tls": "node script/check-tls-fronts.mjs",
    "ci": "npm run format:check && npm run check && npm run lint && npm test -- --run && npm run build && npm audit --audit-level=moderate",
    "precheck": "npm run build:packages",
    "predev": "npm run build:packages",
    "dev": "node script/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run sync --workspace @vrrelay/web",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:compose": "script/compose-smoke.sh",
    "test:cluster-compose": "node script/cluster-compose-smoke.mjs",
    "test:container": "script/container-smoke.sh",
    "test:integration": "node script/integration-harness.mjs",
    "pretest:real-jellyfin": "npm run build",
    "test:real-jellyfin": "node script/real-jellyfin-smoke.mjs",
    "pretest:real-live": "npm run build",
    "test:real-live": "node script/real-live-smoke.mjs",
    "pretest:local-cluster": "npm run build",
    "test:local-cluster": "node script/local-cluster-smoke.mjs",
    "test:watch": "vitest",
    "generate:api": "node script/generate-api.mjs",
    "generate:agent-protocol-schema": "node --import tsx script/generate-agent-protocol-schema.mjs",
    "verify:runtime": "node script/verify-runtime.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "cookie": "2.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
