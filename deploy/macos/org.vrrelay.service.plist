<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.vrrelay.service</string>
  <key>ProgramArguments</key><array>
    <string>VRRELAY_RUNTIME/bin/node</string>
    <string>VRRELAY_RUNTIME/apps/relay/dist/main.js</string>
  </array>
  <key>WorkingDirectory</key><string>VRRELAY_RUNTIME</string>
  <key>EnvironmentVariables</key><dict>
    <key>VRRELAY_DATA_DIR</key><string>VRRELAY_DATA</string>
    <key>VRRELAY_RUNTIME_CONFIG</key><string>VRRELAY_DATA/runtime-config.json</string>
    <key>VRRELAY_RESTART_MODE</key><string>exit</string>
    <key>VRRELAY_CACHE_DIR</key><string>VRRELAY_CACHE</string>
    <key>VRRELAY_FFMPEG</key><string>VRRELAY_RUNTIME/bin/ffmpeg</string>
    <key>VRRELAY_MEDIAMTX_EXECUTABLE</key><string>VRRELAY_RUNTIME/bin/mediamtx</string>
    <key>VRRELAY_MEDIAMTX_CONFIG</key><string>VRRELAY_RUNTIME/mediamtx.yml</string>
    <key>VRRELAY_MEDIAMTX_ALLOW_INTERNAL_READ</key><string>true</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>VRRELAY_LOG/service.log</string>
  <key>StandardErrorPath</key><string>VRRELAY_LOG/service.log</string>
  <key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
