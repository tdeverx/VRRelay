{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": { "$ref": "#/$defs/imageRef" },
    "secrets": {
      "type": "object",
      "required": ["controller", "sourceWorker", "ingestOrigin", "edge"],
      "properties": {
        "controller": { "type": "string", "minLength": 1 },
        "sourceWorker": { "type": "string", "minLength": 1 },
        "ingestOrigin": { "type": "string", "minLength": 1 },
        "edge": { "type": "string", "minLength": 1 }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "runtimeSecretChecksum": { "type": "string" }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "routing": {
      "type": "object",
      "required": ["viewerRegionHeader"],
      "properties": {
        "viewerRegionHeader": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        }
      }
    },
    "vodProducer": {
      "type": "object",
      "required": ["idleTimeout"],
      "properties": {
        "idleTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "externalEgress": {
          "type": "array",
          "items": { "$ref": "#/$defs/ipBlock" }
        },
        "webrtcUdpEgress": {
          "type": "array",
          "items": { "$ref": "#/$defs/ipBlock" }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["controllerUrl", "enrollmentUrl", "tlsNames"],
      "properties": {
        "controllerUrl": { "type": "string", "format": "uri", "pattern": "^wss://" },
        "enrollmentUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tlsNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "controller": { "$ref": "#/$defs/controllerRole" },
    "sourceWorker": { "$ref": "#/$defs/agentRole" },
    "ingestOrigin": { "$ref": "#/$defs/agentRole" },
    "edge": { "$ref": "#/$defs/edgeRole" },
    "mediaMtx": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "image": { "$ref": "#/$defs/imageRef" },
        "publicUrls": {
          "type": "object",
          "required": ["rtmp", "srt", "whip"],
          "properties": {
            "rtmp": { "type": "string", "pattern": "^rtmps?://" },
            "srt": { "type": "string", "pattern": "^srt://" },
            "whip": { "type": "string", "pattern": "^https://" }
          }
        },
        "webrtcAdditionalHosts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "imageRef": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-fA-F]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "ipBlock": {
      "type": "object",
      "required": ["cidr"],
      "properties": {
        "cidr": { "type": "string", "minLength": 1 },
        "except": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "baseRole": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "region": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "controllerRole": {
      "allOf": [{ "$ref": "#/$defs/baseRole" }]
    },
    "agentRole": {
      "allOf": [{ "$ref": "#/$defs/baseRole" }]
    },
    "edgeRole": {
      "allOf": [
        { "$ref": "#/$defs/baseRole" },
        {
          "type": "object",
          "properties": {
            "liveOriginUrl": {
              "type": "string",
              "pattern": "^(srt|rtsp)://",
              "minLength": 10
            }
          },
          "required": ["liveOriginUrl"]
        }
      ]
    }
  }
}
