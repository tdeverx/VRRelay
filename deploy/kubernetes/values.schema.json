{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "secrets": {
      "type": "object",
      "required": ["controller", "sourceWorker", "ingestOrigin", "edge"],
      "properties": {
        "controller": { "type": "string", "minLength": 1 },
        "sourceWorker": { "type": "string", "minLength": 1 },
        "ingestOrigin": { "type": "string", "minLength": 1 },
        "edge": { "type": "string", "minLength": 1 }
      }
    },
    "controller": { "$ref": "#/$defs/controllerRole" },
    "sourceWorker": { "$ref": "#/$defs/agentRole" },
    "ingestOrigin": { "$ref": "#/$defs/agentRole" },
    "edge": { "$ref": "#/$defs/edgeRole" },
    "mediaMtx": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "image": { "type": "string", "minLength": 1 },
        "publicUrls": {
          "type": "object",
          "required": ["rtmp", "srt", "whip"],
          "properties": {
            "rtmp": { "type": "string", "pattern": "^rtmps?://" },
            "srt": { "type": "string", "pattern": "^srt://" },
            "whip": { "type": "string", "pattern": "^https://" }
          }
        },
        "webrtcAdditionalHosts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "baseRole": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "region": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "controllerRole": {
      "allOf": [{ "$ref": "#/$defs/baseRole" }]
    },
    "agentRole": {
      "allOf": [{ "$ref": "#/$defs/baseRole" }]
    },
    "edgeRole": {
      "allOf": [
        { "$ref": "#/$defs/baseRole" },
        {
          "type": "object",
          "properties": {
            "liveOriginUrl": {
              "type": "string",
              "pattern": "^(srt|rtsp)://",
              "minLength": 10
            }
          },
          "required": ["liveOriginUrl"]
        }
      ]
    }
  }
}
