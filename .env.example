VRRELAY_LISTEN_ADDR=127.0.0.1:8099
VRRELAY_PUBLIC_URL=http://127.0.0.1:8099
# Required before first-run setup when PUBLIC_URL is not loopback. Generate a
# random value with at least 32 characters, complete setup, then remove it.
VRRELAY_SETUP_TOKEN=
VRRELAY_DATA_DIR=.data
VRRELAY_CACHE_DIR=.cache
VRRELAY_CACHE_LIMIT_BYTES=21474836480
VRRELAY_FFMPEG=ffmpeg
VRRELAY_MAX_WORKERS=2
VRRELAY_CACHE_TTL=30m
VRRELAY_LOG_LEVEL=info

# Enable only when the relay cannot be reached directly and every forwarding
# proxy is trusted. The current boolean form trusts all proxy hops.
VRRELAY_TRUST_PROXY=false

# Set both values only when the relay service should supervise MediaMTX.
VRRELAY_MEDIAMTX_EXECUTABLE=
VRRELAY_MEDIAMTX_CONFIG=
VRRELAY_MEDIAMTX_HLS_URL=http://127.0.0.1:8888
VRRELAY_MEDIAMTX_RTMP_URL=rtmp://127.0.0.1:1935
VRRELAY_MEDIAMTX_SRT_URL=srt://127.0.0.1:8890
VRRELAY_MEDIAMTX_WHIP_URL=http://127.0.0.1:8889
VRRELAY_MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
VRRELAY_MEDIAMTX_API_URL=http://127.0.0.1:9997
# Edge nodes set this to the ingest origin's public or private-overlay SRT/RTSP URL.
# Leave unset in standalone/controller/source-worker/ingest-origin deployments.
VRRELAY_LIVE_ORIGIN_URL=
# Required when SRT crosses an untrusted network; store separately from the URL.
VRRELAY_LIVE_SRT_PASSPHRASE=
# Optional credential-free base URLs advertised as backup publisher endpoints.
VRRELAY_BACKUP_RTMP_URL=
VRRELAY_BACKUP_SRT_URL=
# Comma-separated public/LAN IPs or DNS names advertised to OBS for WHIP media.
VRRELAY_WEBRTC_ADDITIONAL_HOSTS=
# Enable only for a private, co-located MediaMTX instance whose API and HLS
# listeners cannot be reached by untrusted clients.
VRRELAY_MEDIAMTX_ALLOW_INTERNAL_READ=false
VRRELAY_MEDIAMTX_READ_TOKEN=

# Required for encrypted-file secrets on Linux. Generate at least 32 random
# bytes and store it through Docker secrets in production.
VRRELAY_MASTER_KEY=
VRRELAY_SECRET_BACKEND=auto

# Cluster mode. Standalone defaults need none of these.
VRRELAY_NODE_ID=standalone
VRRELAY_NODE_NAME=VRRelay node
VRRELAY_NODE_REGION=local
VRRELAY_NODE_ROLES=controller,source-worker,ingest-origin,edge
VRRELAY_AGENT_LISTEN_ADDR=127.0.0.1:8100
VRRELAY_AGENT_TLS_NAMES=localhost
VRRELAY_CONTROLLER_AGENT_URL=
VRRELAY_CONTROLLER_ENROLLMENT_URL=
VRRELAY_NODE_JOIN_TOKEN=
VRRELAY_METRICS_TOKEN=
VRRELAY_REPOSITORY_DRIVER=sqlite
VRRELAY_POSTGRES_URL=
VRRELAY_COORDINATION_DRIVER=memory
VRRELAY_VALKEY_URL=
VRRELAY_OBJECT_STORE_DRIVER=local
# Local storage defaults to <VRRELAY_DATA_DIR>/objects when left blank.
VRRELAY_OBJECT_STORE_PATH=
VRRELAY_OBJECT_STORE_BUCKET=
VRRELAY_OBJECT_STORE_PREFIX=vrrelay

# S3-compatible object storage.
VRRELAY_S3_ENDPOINT=
VRRELAY_S3_REGION=us-east-1
VRRELAY_S3_ACCESS_KEY_ID=
VRRELAY_S3_SECRET_ACCESS_KEY=

# Azure Blob object storage. Account name/key are optional when the selected
# Azure credential chain supplies them outside this file.
VRRELAY_AZURE_ACCOUNT_URL=
VRRELAY_AZURE_ACCOUNT_NAME=
VRRELAY_AZURE_ACCOUNT_KEY=

# Google Cloud Storage. Leave the key filename blank to use application-default
# credentials supplied outside this file.
VRRELAY_GCS_PROJECT_ID=
VRRELAY_GCS_KEY_FILENAME=

# Bundled cluster Compose uses separate MinIO identities. Root credentials are
# consumed only by the one-shot bootstrap container; relay nodes use the
# role-scoped accounts below.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_CONTROLLER_USER=vrrelay-controller
MINIO_CONTROLLER_PASSWORD=
MINIO_SOURCE_USER=vrrelay-source
MINIO_SOURCE_PASSWORD=
MINIO_EDGE_USER=vrrelay-edge
MINIO_EDGE_PASSWORD=
MINIO_INGEST_USER=vrrelay-ingest
MINIO_INGEST_PASSWORD=

# Real Jellyfin credentials are entered through the dashboard and stored in the
# configured secret backend. Do not place them in this file.
